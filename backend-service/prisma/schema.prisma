generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  mobileNumber    String
  role            Role
  status          Status           @default(PENDING)
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  artisanProfile  ArtisanProfile?
  buyerProfile    BuyerProfile?
  enquiryMessages EnquiryMessage[]
  notifications   Notification[]

  @@unique([mobileNumber, role])
}

model ArtisanProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  name              String
  craftType         String
  state             String
  district          String
  preferredLanguage String
  user              User      @relation(fields: [userId], references: [id])
  enquiries         Enquiry[]
  orders            Order[]
  products          Product[]
}

model BuyerProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  name         String
  businessName String
  businessType String
  state        String
  district     String
  user         User      @relation(fields: [userId], references: [id])
  enquiries    Enquiry[]
  orders       Order[]
}

model Product {
  id          String         @id @default(uuid())
  artisanId   String
  productName Json
  category    String
  material    String?
  description Json
  tags        String[]
  imageUrl    String?
  suggestedPriceMin  Float?
  suggestedPriceMax  Float?
  currency           String?
  pricingExplanation String?
  status      ProductStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  enquiries   Enquiry[]
  orders      Order[]
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id])

  @@index([artisanId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Order {
  id           String         @id @default(uuid())
  buyerId      String
  artisanId    String
  status       OrderStatus    @default(PENDING)
  totalAmount  Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  productId    String?
  requestedQty Int            @default(1)
  acceptedQty  Int?
  unitPrice    Float?
  requiredBy   DateTime?
  artisan      ArtisanProfile @relation(fields: [artisanId], references: [id])
  buyer        BuyerProfile   @relation(fields: [buyerId], references: [id])
  product      Product?       @relation(fields: [productId], references: [id])

  @@index([artisanId, status])
  @@index([buyerId, status])
}

model Enquiry {
  id        String           @id @default(uuid())
  buyerId   String
  artisanId String
  productId String?
  message   String
  status    EnquiryStatus    @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  artisan   ArtisanProfile   @relation(fields: [artisanId], references: [id])
  buyer     BuyerProfile     @relation(fields: [buyerId], references: [id])
  product   Product?         @relation(fields: [productId], references: [id])
  messages  EnquiryMessage[]

  @@index([artisanId, status])
  @@index([buyerId, status])
}

model EnquiryMessage {
  id        String   @id @default(uuid())
  enquiryId String
  senderId  String
  message   String
  createdAt DateTime @default(now())
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([enquiryId, createdAt])
}

enum Role {
  ARTISAN
  BUYER
}

enum Status {
  PENDING
  ACTIVE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum NotificationType {
  INFO
  ORDER
  ENQUIRY
  SYSTEM
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
  PARTIALLY_ACCEPTED
  FULFILLING
}

enum EnquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}
